# Compartidas por los cuatro entrypoints de este directorio: server.js (API,
# npm start), ingestaServer.js (ingesta de Excel, npm run start:ingesta),
# sesionServer.js (usuarios/roles, npm run start:sesion) y adminServer.js
# (lectura de bitácora, npm run start:admin).

PORT=3001

# Secreto compartido que debe enviar el watcher (scripts/watch-and-push.mjs)
# en el header x-refresh-secret al llamar POST /api/webhook/refresh. Si se
# deja vacío, el endpoint queda sin protección — es la única autenticación
# que tiene ingestaServer.js (sin cookies, sin sesión).
REFRESH_SECRET=

# Cadena de conexión a Postgres, ej: postgres://localhost:5432/panel
# Si se deja vacía, el panel sigue funcionando en modo solo lectura desde el Excel.
DATABASE_URL=

# Opcional: aísla las tablas en un schema propio cuando varios entornos
# comparten una misma Postgres (ver backend/src/db/pool.js). Sin setear,
# usa "public" — comportamiento sin cambios para quien no lo necesite.
DB_SCHEMA=

# --- Solo server.js (la API) — los otros tres entrypoints las ignoran por
# completo, no tienen cookies, CORS ni sirven al navegador directamente. ---

# Origen exacto del frontend (para permitir la cookie de sesión entre dominios).
CORS_ORIGIN=http://localhost:5173

# Secreto para firmar la cookie de sesión y la de "ver como" (ver
# VER_COMO_CORREOS más abajo). Cambiar por uno propio en producción.
COOKIE_SECRET=

# URL base de sesionServer.js: server.js le delega login/usuarios/roles
# (llamada interna, nunca la hace el navegador). En local, el puerto default
# de sesionServer.js es 3003.
SESION_URL=http://localhost:3003

# URL base de adminServer.js: server.js le delega la lectura de audit_log
# (llamada interna, nunca la hace el navegador). En local, el puerto
# default de adminServer.js es 3004.
ADMIN_URL=http://localhost:3004

# Correos (separados por coma) habilitados para "ver como" — cambiar
# temporalmente de rol en su propia sesión para probar que el backend
# aplica bien las restricciones de cada rol. Deliberadamente acotado: sin
# correos acá, nadie puede usar la función. Solo lo lee server.js.
VER_COMO_CORREOS=

# --- Solo sesionServer.js — server.js/ingestaServer.js no la usan. ---

# Secreto compartido en el header x-sesion-secret que server.js debe enviar
# al llamar a las rutas /internal/* de sesionServer.js. Si se deja vacío,
# esas rutas quedan sin protección.
SESION_SECRET=

# Correos (separados por coma) que quedan como rol 'administrador' en cada
# login, sin depender de haber sido aprovisionados de antemano por un
# administrador. Mecanismo de arranque: sin esto, nadie podría darse de
# alta a sí mismo como el primer administrador de un entorno nuevo. Opcional.
BOOTSTRAP_ADMIN_EMAILS=

# --- Solo adminServer.js — los otros tres entrypoints no la usan. ---

# Secreto compartido en el header x-admin-secret que server.js debe enviar
# al llamar a las rutas /internal/* de adminServer.js. Si se deja vacío,
# esas rutas quedan sin protección.
ADMIN_SECRET=
