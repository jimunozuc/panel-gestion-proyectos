{
  "name": "panel-gestion-proyectos-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "dev:ingesta": "node --watch --env-file-if-exists=.env src/ingestaServer.js",
    "dev:sesion": "node --watch --env-file-if-exists=.env src/sesionServer.js",
    "start": "node src/server.js",
    "start:ingesta": "node src/ingestaServer.js",
    "start:sesion": "node src/sesionServer.js",
    "test": "node --test --test-concurrency=1",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  },
  "overrides": {
    "archiver": "^8.0.0",
    "unzipper": "^0.12.5",
    "uuid": "^11.1.1"
  }
}
