EXCEL_FILE_PATH=/Users/tu-usuario/Library/CloudStorage/OneDrive-.../panel_iniciativas.xlsx
BACKUP_INTERVAL_MINUTES=5

# Un solo destino (fallback si no se setea PUSH_TARGETS_JSON):
BACKEND_URL=https://panel-gestion-proyectos-backend.onrender.com
REFRESH_SECRET=el-mismo-valor-configurado-en-render

# Varios destinos a la vez (tiene prioridad sobre BACKEND_URL/REFRESH_SECRET
# si está seteada) — un objeto por servicio, cada uno con su propio secreto.
# Reemplazar las URLs de ingesta por las reales una vez creados esos
# servicios en Render (ver README, "Pasos para desplegar un backend nuevo").
# PUSH_TARGETS_JSON=[{"name":"prod","url":"https://panel-gestion-proyectos-backend.onrender.com","secret":"..."},{"name":"ingesta-app","url":"https://tu-servicio-ingesta-app.onrender.com","secret":"..."},{"name":"ingesta-dev","url":"https://tu-servicio-ingesta-dev.onrender.com","secret":"..."}]
