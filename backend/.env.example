PORT=3001

# URL de descarga directa del Excel en SharePoint ("Cualquiera con el vínculo").
# Si se deja vacío, el backend usa data/panel_iniciativas.xlsx como respaldo local.
SHAREPOINT_XLSX_URL=

# Secreto compartido que debe enviar Power Automate en el header x-refresh-secret
# al llamar POST /api/webhook/refresh. Si se deja vacío, el endpoint queda sin protección.
REFRESH_SECRET=
